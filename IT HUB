local function shaderClear()
	if shaderFx then
		for _, e in ipairs(shaderFx) do pcall(function() e:Destroy() end) end
		shaderFx = nil
	end
	if shaderSaved then
		pcall(function()
			Lighting.Ambient = shaderSaved.a
			Lighting.OutdoorAmbient = shaderSaved.o
			Lighting.ColorShift_Top = shaderSaved.t
			Lighting.ColorShift_Bottom = shaderSaved.b
		end)
		shaderSaved = nil
	end
end
local function shaderApply(kind)
	local keep = shaderSaved
	shaderClear()
	if not kind then return end
	shaderSaved = keep or {a = Lighting.Ambient, o = Lighting.OutdoorAmbient, t = Lighting.ColorShift_Top, b = Lighting.ColorShift_Bottom}
	local cc = mk("ColorCorrectionEffect", {Name = "IT_Shader"}, Lighting)
	local bloom = mk("BloomEffect", {Name = "IT_Shader_Bloom"}, Lighting)
	local tone
	if kind == "pink" then
		tone = Color3.fromRGB(255, 105, 180)
		cc.TintColor = Color3.fromRGB(255, 150, 205)
		cc.Saturation = 0.25 cc.Contrast = 0.1 cc.Brightness = 0.04
		bloom.Intensity = 0.6 bloom.Size = 30 bloom.Threshold = 1.2
	else
		tone = Color3.new(1, 1, 1)
		cc.TintColor = Color3.new(1, 1, 1)
		cc.Saturation = -0.7 cc.Contrast = -0.25 cc.Brightness = 0.35
		bloom.Intensity = 1.2 bloom.Size = 40 bloom.Threshold = 0.8
	end
	pcall(function()
		Lighting.Ambient = tone
		Lighting.OutdoorAmbient = tone
		Lighting.ColorShift_Top = tone
		Lighting.ColorShift_Bottom = tone
	end)
	shaderFx = {cc, bloom}
end

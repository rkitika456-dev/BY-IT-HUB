selectPage = function(pg)
	curPage = pg
	for _, p in ipairs(pages) do
		p.frame.Visible = p == pg
		p.btn.BackgroundTransparency = (p == pg) and 0 or 0.6
		p.btn.TextColor3 = (p == pg) and WHITE or SUB
	end
	title.Text = pg.name
	sub.Text = pg.sub
	hideOutsides()
	applyFilter()
end

